<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Media access: Android 10 (29) / 11-12 (30-32) / 13+ (33+) permission model -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Set photo as wallpaper -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <application
        android:name=".GalleryApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.GalleryX"
        tools:targetApi="31">

        <!-- Main screen: photo timeline + albums -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Static shortcut: unlock hidden album (must live inside the launcher activity) -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Full screen photo / video viewer, also handles VIEW intents from other apps -->
        <activity
            android:name=".ui.ViewerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- Album / favorites / hidden / trash collection grid -->
        <activity
            android:name=".ui.CollectionActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Search -->
        <activity
            android:name=".ui.SearchActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:windowSoftInputMode="stateVisible|adjustPan" />

        <!-- Settings -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!-- PIN pad for the hidden album -->
        <activity
            android:name=".ui.PinActivity"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <!-- Photo editor (rotate, flip, filters) -->
        <activity
            android:name=".ui.EditorActivity"
            android:exported="false"
            android:parentActivityName=".ui.ViewerActivity" />

    </application>

</manifest>
